# Copy to .env and fill in your own values. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# setup.sh renders every config/*.template from these variables, so nothing
# site-specific ever ends up in git.
#
# The network values below are RFC 5737 / RFC 3849 documentation addresses --
# placeholders. Replace them with the ones from your ISP.

# ----------------------------------------------------------------- interfaces
WAN_IF="enp3s0"
LAN_IF="enp4s0"
WIFI_IF="wlp6s0"
BRIDGE_IF="br0"
# Space separated, configured but left unaddressed. Empty is fine.
UNUSED_IFS="enp5s0f0np0 enp5s0f1np1"

# ----------------------------------------------------------------- WAN (IPv4)
WAN_IP4_PRIMARY="203.0.113.10"
# Extra static addresses on the same WAN interface. Leave empty if unused.
WAN_IP4_SECONDARY="203.0.113.11"
WAN_IP4_TERTIARY="203.0.113.12"
WAN_IP4_PREFIXLEN="24"
WAN_GW4="203.0.113.1"

# ----------------------------------------------------------------- WAN (IPv6)
WAN_IP6="2001:db8:1::2"
WAN_IP6_PREFIXLEN="64"
WAN_GW6="2001:db8:1::1"

# ----------------------------------------------------------------- LAN (IPv4)
LAN_IP4="192.168.1.1"
LAN_NET4="192.168.1.0/24"
LAN_NETMASK4="255.255.255.0"
LAN_DHCP4_START="192.168.1.100"
LAN_DHCP4_END="192.168.1.200"
LAN_DHCP4_LEASE="12h"

# ----------------------------------------------------------------- LAN (IPv6)
# LAN_NET6 is the routed prefix delegated by the ISP (typically a /48).
# LAN_IP6 is the router address inside the /64 announced to LAN clients.
LAN_NET6="2001:db8:100::/48"
LAN_IP6="2001:db8:100:1::1"
LAN_IP6_PREFIXLEN="64"

LAN_DOMAIN="lan"

# ----------------------------------------------------------------- DNS
DNS4_1="1.1.1.1"
DNS4_2="8.8.8.8"
DNS6_1="2606:4700:4700::1111"

# ----------------------------------------------------------------- Wi-Fi
WIFI_SSID="homerouter"
# 8-63 characters. Used for both WPA2-PSK and WPA3-SAE.
WIFI_PASSPHRASE="change-me-please"

# Regulatory domain (ISO 3166-1 alpha-2).
WIFI_COUNTRY_CODE="DK"

# 5 GHz (recommended):  HW_MODE=a  CHANNEL=36  VHT=1
# 2.4 GHz:              HW_MODE=g  CHANNEL=6   VHT=0
WIFI_HW_MODE="a"
WIFI_CHANNEL="36"
WIFI_VHT="1"

# 0 = WPA2+WPA3 mixed (broadest client support)
# 1 = WPA3-SAE only (requires modern clients, enforces PMF)
WIFI_WPA3_ONLY="0"
