# Copy to .env and fill in your own values. Never commit .env.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# setup.sh renders every config/*.template from these variables, so nothing
# site-specific ever ends up in git.
#
# The network values below are RFC 5737 / RFC 3849 documentation addresses --
# placeholders. Replace them with the ones from your ISP.

# ----------------------------------------------------------------- interfaces
WAN_IF="enp3s0"
LAN_IF="enp4s0"
WIFI_IF="wlp6s0"
BRIDGE_IF="br0"
# Space separated, configured but left unaddressed. Empty is fine.
# The npX suffix marks the SFP/SFP+ cage ports: no transceiver (DAC cable or
# optical module) means no carrier, so `ip link` shows them NO-CARRIER.
UNUSED_IFS="enp5s0f0np0 enp5s0f1np1"

# ----------------------------------------------------------------- WAN (IPv4)
WAN_IP4_PRIMARY="203.0.113.10"
# Extra static addresses on the same WAN interface. Leave empty if unused.
WAN_IP4_SECONDARY="203.0.113.11"
WAN_IP4_TERTIARY="203.0.113.12"
WAN_IP4_PREFIXLEN="24"
WAN_GW4="203.0.113.1"

# ----------------------------------------------------------------- WAN (IPv6)
WAN_IP6="2001:db8:1::2"
WAN_IP6_PREFIXLEN="64"
WAN_GW6="2001:db8:1::1"

# ----------------------------------------------------------------- LAN (IPv4)
LAN_IP4="10.10.10.1"
LAN_NET4="10.10.10.0/24"
LAN_NETMASK4="255.255.255.0"
LAN_DHCP4_START="10.10.10.100"
LAN_DHCP4_END="10.10.10.200"
LAN_DHCP4_LEASE="12h"

# ----------------------------------------------------------------- LAN (IPv6)
# LAN_NET6 is the routed prefix delegated by the ISP (typically a /48).
# LAN_IP6 is the router address inside the /64 announced to LAN clients.
LAN_NET6="2001:db8:100::/48"
LAN_IP6="2001:db8:100:1::1"
LAN_IP6_PREFIXLEN="64"

LAN_DOMAIN="lan"

# ------------------------------------------------ second segment (servers/DMZ)
# An optional, separate network for self-hosted services. It is a different
# layer-2 segment on its own NIC, not just another subnet: LAN can reach it,
# it cannot reach back into the LAN.
#
# SRV_IF must be a NIC that is NOT listed in UNUSED_IFS.
SRV_ENABLE="0"
SRV_IF="enp5s0f0np0"       # SFP+ port -- needs a transceiver and an SFP+ switch
SRV_BRIDGE_IF="br1"

SRV_IP4="10.10.20.1"
SRV_NET4="10.10.20.0/24"
SRV_NETMASK4="255.255.255.0"
SRV_DHCP4_START="10.10.20.100"
SRV_DHCP4_END="10.10.20.200"

# Second /64 out of the same routed prefix.
SRV_IP6="2001:db8:100:2::1"
SRV_IP6_PREFIXLEN="64"
SRV_DOMAIN="srv"

# 1 = servers may open connections into the LAN (default: no).
SRV_TO_LAN="0"

# ------------------------------------------------------------------- Docker
# Set to 1 if this box also runs Docker. The firewall is default-drop, so
# container traffic needs explicit rules, and setup.sh restarts Docker after
# loading the ruleset so it can reinstall its own chains.
DOCKER_COMPAT="0"

# ----------------------------------------------------------------- DNS
DNS4_1="1.1.1.1"
DNS4_2="8.8.8.8"
DNS6_1="2606:4700:4700::1111"

# ----------------------------------------------------------------- Wi-Fi
WIFI_SSID="homerouter"
# 8-63 characters. Used for both WPA2-PSK and WPA3-SAE.
WIFI_PASSPHRASE="change-me-please"

# Regulatory domain (ISO 3166-1 alpha-2).
WIFI_COUNTRY_CODE="DK"

# 5 GHz (recommended):  HW_MODE=a  CHANNEL=36  VHT=1
# 2.4 GHz:              HW_MODE=g  CHANNEL=6   VHT=0
WIFI_HW_MODE="a"
WIFI_CHANNEL="36"
WIFI_VHT="1"

# 0 = WPA2+WPA3 mixed (broadest client support)
# 1 = WPA3-SAE only (requires modern clients, enforces PMF)
WIFI_WPA3_ONLY="0"
