{
  "manifest_version": 3,
  "name": "homerouter.io",
  "description": "Connect to the homerouter.io authenticated HTTPS proxy with verified credentials and one-click tunnel disconnect.",
  "homepage_url": "https://github.com/mklarsen/homerouter/tree/main/addons/proxy-extension",
  "version": "1.4.0",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "homerouter.io",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}